{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drdeesha",

  // Nitro's cloudflare_module preset emits the server entry here and the
  // prerendered/static files into .output/public. Both paths are fixed by the
  // preset — they only exist if nuxt.config.ts sets nitro.preset accordingly.
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets are served straight from the edge without invoking the
  // Worker. The home page is prerendered (routeRules in nuxt.config.ts), so
  // the common request never reaches server code at all.
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },

  // Routing is deliberately NOT declared here. drdeeshadental.com is a client
  // domain whose zone lives outside this Cloudflare account, so wrangler
  // cannot bind it as a custom domain — it fails with "Could not find zone
  // for drdeeshadental.com" and the deploy aborts.
  //
  // workers_dev is left at its default (true) for the same reason. With the
  // apex unbindable from here, the *.workers.dev hostname is likely how
  // traffic actually reaches the Worker (client DNS pointing at it, or
  // Cloudflare for SaaS), so turning it off would take production down on an
  // otherwise green deploy. Whether it can be disabled depends on how the
  // client's zone is wired to this Worker — worth settling separately, since
  // an open workers.dev origin is a second crawlable copy of the site that
  // no zone-level WAF or caching rule covers.
  //
  // Until then domain and route bindings stay dashboard-managed, which is how
  // they worked before this file existed.

  "observability": {
    "enabled": true
  }
}
